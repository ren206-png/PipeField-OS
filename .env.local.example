# ============================================================
# PipeField OS — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git — it contains secrets.
# ============================================================

# --- Supabase ---
# Found in your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PipeField OS

# --- Stripe ---
# Found in Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs — run scripts/create-field-pro-stripe-products.ts
# to generate the Field Pro price ID, then paste it here.
# Run the existing product setup for other plans similarly.

# Field Pro — Individual plan ($9/mo, 1 seat)
# Add these values to production secrets BEFORE deploying Field Pro.
STRIPE_PRICE_FIELD_PRO_MONTHLY=price_...

# Team plans
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Optional: Python FastAPI backend for pipe support calculations
# PIPEFIELD_BACKEND_URL=http://localhost:8000

# --- Cron Jobs ---
# Add to Vercel env vars: CRON_SECRET=your-random-secret-here
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret-here
