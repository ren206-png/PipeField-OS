# ============================================================
# PipeField OS — Local Development Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git — it contains secrets.
# ============================================================

# ── Supabase (required) ──────────────────────────────────────
# Found in Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App (required) ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PipeField OS
# Surfaced by /api/health — set to your git SHA or semver tag in CI
NEXT_PUBLIC_APP_VERSION=local

# ── Internal API security (required) ────────────────────────
# Used to authenticate server-to-server calls (e.g. knowledge processing).
# Generate with: openssl rand -hex 32
# Must match the value set in Vercel / your hosting env.
INTERNAL_API_SECRET=your-random-secret-here

# ── Cron jobs ────────────────────────────────────────────────
# Protects /api/cron/* endpoints from public invocation.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret-here

# ── Stripe (required for billing features) ───────────────────
# Found in Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs — run scripts/create-field-pro-stripe-products.ts to generate.
# After creation, paste the price IDs from Stripe Dashboard → Products.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_PRICE_FIELD_PRO=price_...
STRIPE_PRICE_FIELD_PRO_MONTHLY=price_...
STRIPE_PRICE_FIELD_PRO_ANNUAL=price_...

# ── Email (required for invite / notification emails) ────────
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_...
# The "from" address must be a verified domain in Resend
EMAIL_FROM=noreply@yourdomain.com

# ── OpenAI (required for PipeField Intelligence) ─────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Sentry (optional — error tracking) ──────────────────────
# https://sentry.io → Project Settings → Client Keys (DSN)
# Install package first: npm install @sentry/nextjs
# Leave blank to disable error reporting entirely.
SENTRY_DSN=
# Fraction of traces to sample (0.0–1.0). Keep low in production.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Analytics (optional) ─────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-...

# ── PipeField Backend (optional — pipe support calculations) ─
# Python FastAPI backend URL. Leave blank if not running locally.
PIPEFIELD_BACKEND_URL=http://localhost:8000
PIPEFIELD_BACKEND_API_KEY=your-backend-api-key
