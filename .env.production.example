# ============================================================
# PipeField OS — Production Environment Variables
# Copy these into Vercel Dashboard → Settings → Environment Variables
# ============================================================

# Supabase — get from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App URL — set to your Vercel deployment URL or custom domain
NEXT_PUBLIC_APP_URL=https://pipefield-os.vercel.app

# Stripe — get from Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — get from Stripe Dashboard → Products
# Create one product per plan with monthly recurring pricing
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Stripe Publishable Key (safe for client-side use)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
