# ============================================================
# PipeField OS — Production Environment Variables
# Add these to Vercel Dashboard → Settings → Environment Variables
# (or your hosting provider's secret store).
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.yourdomain.com
NEXT_PUBLIC_APP_NAME=PipeField OS
# Set to git SHA or semver during CI deploy (e.g. $VERCEL_GIT_COMMIT_SHA)
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Internal API security ────────────────────────────────────
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=replace-with-a-strong-random-secret

# ── Cron jobs ────────────────────────────────────────────────
CRON_SECRET=replace-with-a-strong-random-secret

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_PRICE_FIELD_PRO=price_...
STRIPE_PRICE_FIELD_PRO_MONTHLY=price_...
STRIPE_PRICE_FIELD_PRO_ANNUAL=price_...

# ── Email ────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Sentry (recommended for production) ──────────────────────
SENTRY_DSN=https://...@sentry.io/...
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Analytics ────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-...

# ── PipeField Backend (if deployed) ──────────────────────────
PIPEFIELD_BACKEND_URL=https://api.yourdomain.com
PIPEFIELD_BACKEND_API_KEY=your-backend-api-key
