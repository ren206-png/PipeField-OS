<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ── Capacitor internals ── -->
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>

	<!-- ── Bundle identity ── -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>PipeField OS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- ── Deep link URL scheme (Supabase auth + QR codes) ── -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.rennerkargbo.pipefieldos</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pipefield</string>
			</array>
		</dict>
	</array>

	<!-- ── Push notifications usage description ── -->
	<key>NSUserNotificationUsageDescription</key>
	<string>PipeField OS sends alerts for weld continuity expiry, inspection reminders, and team updates.</string>

	<!-- ── Associated Domains (Universal Links + Supabase) ── -->
	<!-- Enable in Signing & Capabilities → Associated Domains -->
	<!-- Entry: applinks:pipefield-os.com                   -->

	<!-- ── Device requirements ── -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>

	<!-- ── Orientations ── -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ── Status bar ── -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>

	<!-- ── Privacy usage descriptions ── -->
	<!-- Camera — for scanning QR codes on pipe spools/welds -->
	<key>NSCameraUsageDescription</key>
	<string>PipeField OS uses the camera to scan QR codes on pipe spools and weld joints in the field.</string>

	<!-- Photo Library — for attaching weld inspection photos -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>PipeField OS accesses your photo library to attach inspection photos to weld records.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>PipeField OS saves inspection photos to your photo library.</string>

	<!-- Location — for geo-tagging weld inspection records -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PipeField OS can optionally tag weld inspection records with your location in the field.</string>

	<!-- ── App Transport Security ── -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>pipefield-os.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!-- ── Launch storyboard ── -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- ── Background modes (push notifications) ── -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- WKAppBoundDomains intentionally omitted.
	     The browser toolbar is suppressed via the apphttps:// custom URL scheme
	     proxy (VercelProxyHandler). Adding WKAppBoundDomains here would block
	     Capacitor's user script injection into apphttps:// pages because custom
	     schemes are not recognised as app-bound domains by WebKit. -->
</dict>
</plist>
